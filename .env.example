# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google / Firebase API Key
# Replace with your actual rotated Google API key in your private .env file
# NEVER commit your real key to GitHub or public repositories
GOOGLE_API_KEY="YOUR_GOOGLE_API_KEY"
FIREBASE_API_KEY="YOUR_GOOGLE_API_KEY"
VITE_FIREBASE_API_KEY="YOUR_GOOGLE_API_KEY"

# Firebase Project Configuration
VITE_FIREBASE_PROJECT_ID="yachty-land-qlcf1"
VITE_FIREBASE_APP_ID="1:1063593032177:web:9e58856e280783c2d62c50"
VITE_FIREBASE_AUTH_DOMAIN="yachty-land-qlcf1.firebaseapp.com"
VITE_FIREBASE_DATABASE_ID="ai-studio-a9d1724b-2b75-49ba-9939-b9ec96e31f54"
VITE_FIREBASE_STORAGE_BUCKET="yachty-land-qlcf1.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="1063593032177"
